# Proof Server Configuration

# Server settings
SERVER_ADDR=127.0.0.1:3001
RUST_LOG=info,proof_server=debug

# Auto-publish on startup (optional)
# If set, the server will automatically publish commitment and verifying key on-chain
SUI_PACKAGE_ID=0x220720d7ef74d2c30f183ab12a57cc40edc58dbcd4acdd38037da6769baa2a9e
SUI_SERVER_CAP_ID=0x772e45f258b69780de2af6a305394ed84b17e3a8a0a407304f84c56dd503aac4
SUI_RPC_URL=http://127.0.0.1:9000
SUI_KEYSTORE_PATH=/path/to/.sui/sui_config/sui.keystore
